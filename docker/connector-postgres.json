{
  "name": "commerce-connector",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "tasks.max": "1",

    "database.hostname": "postgres",
    "database.port": "5432",
    "database.user": "debezium",
    "database.password": "debezium",
    "database.dbname": "commerce",

    "topic.prefix": "commerce",
    "schema.include.list": "commerce",
    "table.include.list": "commerce.customer,commerce.seller,commerce.product,commerce.order,commerce.order_item",

    "plugin.name": "pgoutput",
    "publication.name": "dbz_commerce",
    "publication.autocreate.mode": "disabled",
    "slot.name": "dbz_commerce_slot",

    "snapshot.mode": "initial",

    "decimal.handling.mode": "string",
    "time.precision.mode": "connect",

    "tombstones.on.delete": "false",

    "topic.creation.enable": "true",
    "topic.creation.default.replication.factor": "1",
    "topic.creation.default.partitions": "1",
    "topic.creation.default.cleanup.policy": "delete",
    "topic.creation.default.retention.ms": "-1",

    "heartbeat.interval.ms": "10000",

    "key.converter": "org.apache.kafka.connect.json.JsonConverter",
    "key.converter.schemas.enable": "false",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "false"
  }
}
